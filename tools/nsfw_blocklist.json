      "danbooru": "Terms commonly used as Danbooru tag categories (rating:explicit, sexual tags). Danbooru's tag classification system was referenced for identifying NSFW tags.",
      "civitai": "Terms observed across CivitAI model metadata and prompt datasets. CivitAI's content moderation categories informed tier classification.",
      "manual_curation": "Manual curation and cross-referencing of community-maintained blocklists, prompt engineering resources, and adult content filtering guidelines."
    },
    "tier_system": {
      "hard_block": "Tier 1 — Terms that should ALWAYS be removed from catalogs. These represent explicit sexual content, extreme fetishes, prohibited content (age-related), bodily fluids, and non-consensual themes. No user toggle — always filtered.",
      "suggestive": "Tier 2 — Terms that are sexually suggestive but may overlap with legitimate artistic/character descriptor usage. Filtering is configurable and defaults to disabled. Users may choose to enable if they want stricter content control."
    },
    "matching_notes": [
      "All term matching is case-insensitive.",
      "Terms are matched against item.name and item.id fields in CatalogCleaner.",
      "Regex patterns use word boundary assertions ((?<![a-z])/(?![a-z])) to prevent partial matches.",
      "Multi-word terms are provided both as exact phrases (for literal matching) and as compound regex patterns.",
      "Some terms (marked in notes) have significant SFW overlap and may benefit from NLP/contextual disambiguation at the application layer.",
      "This blocklist is a static wordlist — it cannot detect euphemisms, obfuscated spellings, or non-English NSFW terms.",
      "Regular maintenance is recommended as community terminology evolves."
    ],
    "usage": "Loaded by CatalogCleaner which iterates over catalog items and matches item.name and item.id against these patterns. Items matching hard_block terms are automatically removed. Items matching suggestive terms are flagged or removed based on user configuration.",
    "maintenance_notes": [
      "Review and update quarterly to capture emerging terms and community slang.",
      "Monitor source platforms (Danbooru, CivitAI) for tag taxonomy changes.",
      "Consider adding non-English NSFW terms if multilingual catalog support is added.",
      "False positive reports from users should trigger term review and potential demotion to a lower tier."
    ]
  }
